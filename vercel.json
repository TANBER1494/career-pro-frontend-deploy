{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/src/pages/admin/dashboard.html" },
    { "source": "/admin/jobs", "destination": "/src/pages/admin/jobs.html" },
    { "source": "/admin/users", "destination": "/src/pages/admin/users.html" },
    {
      "source": "/admin/verifications",
      "destination": "/src/pages/admin/verifications.html"
    },

    { "source": "/login", "destination": "/src/pages/auth/signup-login.html" },
    { "source": "/signup", "destination": "/src/pages/auth/signup-login.html" },
    {
      "source": "/verify-email",
      "destination": "/src/pages/auth/verify-email.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/src/pages/auth/forgot-password.html"
    },
    {
      "source": "/reset-password",
      "destination": "/src/pages/auth/reset-password.html"
    },
    { "source": "/CareerPro", "destination": "/index.html" },
    {
      "source": "/companies",
      "destination": "/src/pages/public companies/companies.html"
    },
    {
      "source": "/company-details",
      "destination": "/src/pages/public companies/companyDetails.html"
    },
    {
      "source": "/jobs",
      "destination": "/src/pages/public jobs/jobs.html"
    },
    {
      "source": "/profile",
      "destination": "/src/pages/seeker/profile/profile.html"
    },
    {
      "source": "/SeekerStep1",
      "destination": "/src/pages/seeker/seeker steps/ProfileStep1.html"
    },
    {
      "source": "/SeekerStep2",
      "destination": "/src/pages/seeker/seeker steps/ProfileStep2.html"
    },
    {
      "source": "/SeekerStep3",
      "destination": "/src/pages/seeker/seeker steps/ProfileStep3.html"
    },
    {
      "source": "/applications",
      "destination": "/src/pages/company/company portal/applications.html"
    },
    {
      "source": "/Company_dashboard",
      "destination": "/src/pages/company/company portal/dashboard.html"
    }
    ,
    {
      "source": "/Company_profile",
      "destination": "/src/pages/company/company portal/profile.html"
    },
    {
      "source": "/Company_jobs",
      "destination": "/src/pages/company/company portal/jobs.html"
    }
  ]
}
